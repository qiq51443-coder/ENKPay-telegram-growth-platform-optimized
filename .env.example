# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/telegram_growth

# Backend Configuration
BACKEND_PORT=3000
BACKEND_URL=http://localhost:3000
JWT_SECRET=your-secret-key-here
CORS_ORIGIN=http://localhost:3001

# Bot Configuration
BOT_TOKEN=your-telegram-bot-token
BOT_ID=your-bot-id-from-admin-panel
BOT_WEBHOOK_URL=https://yourdomain.com/webhook
BOT_WEBHOOK_SECRET=your-webhook-secret

# Admin Configuration
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_SECRET=your-admin-secret

# Platform Configuration
PLATFORM_NAME=YourPlatform
PLATFORM_URL=https://platform.example.com
PLATFORM_REGISTER_URL=https://platform.example.com/register

# Telegram Groups/Channels
REQUIRED_CHANNEL_ID=@yourchannel
REQUIRED_GROUP_ID=-1001234567890
SCREENSHOT_GROUP_ID=-1001234567890

# Rewards Configuration
FOLLOW_REWARD=50
BIND_REWARD=100
INVITE_REWARD=25
SCREENSHOT_REWARD_CREDITS=1
NEW_USER_RED_PACKET_CREDITS=3

# Redis Configuration (for real-time sync)
REDIS_URL=redis://localhost:6379

# File Storage
FILE_STORAGE_PATH=./uploads

# Wallet HD Encryption
WALLET_ENCRYPTION_KEY=your-wallet-encryption-key-32chars-min

# Blockchain API Keys (for deposit detection via webhooks)
TRONGRID_API_KEY=your-trongrid-api-key
ETHERSCAN_API_KEY=your-etherscan-api-key
BSCSCAN_API_KEY=your-bscscan-api-key

# Binance API – if you get HTTP 451 (Unavailable For Legal Reasons) on your host,
# try api1.binance.com or api2.binance.com. The service will also auto-retry
# these mirrors before falling back to api.binance.com.
BINANCE_API_URL=https://api1.binance.com

# PM2 Configuration
PM2_INSTANCES=4
