# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/telegram_growth

# Backend Configuration
BACKEND_PORT=3000
BACKEND_URL=http://localhost:3000
JWT_SECRET=your-secret-key-here

# Bot Configuration
BOT_TOKEN=your-telegram-bot-token
BOT_ID=your-bot-id-from-admin-panel
BOT_WEBHOOK_URL=https://yourdomain.com/webhook
BOT_WEBHOOK_SECRET=your-webhook-secret

# Admin Configuration
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_SECRET=your-admin-secret

# Platform Configuration
PLATFORM_NAME=YourPlatform
PLATFORM_URL=https://platform.example.com
PLATFORM_REGISTER_URL=https://platform.example.com/register

# Telegram Groups/Channels
REQUIRED_CHANNEL_ID=@yourchannel
REQUIRED_GROUP_ID=-1001234567890
SCREENSHOT_GROUP_ID=-1001234567890

# Rewards Configuration
FOLLOW_REWARD=50
BIND_REWARD=100
INVITE_REWARD=25
SCREENSHOT_REWARD_CREDITS=1
NEW_USER_RED_PACKET_CREDITS=3

# Redis Configuration (for real-time sync)
REDIS_URL=redis://localhost:6379

# File Storage
FILE_STORAGE_PATH=./uploads
